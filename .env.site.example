# Variáveis da stack do site institucional (docker-compose.site.yml).
# Copie para .env.site na VPS. Não vai para o git.

# Domínio que o Traefik vai rotear para o site.
SITE_DOMAIN=www.officestecnologia.com.br

# Precisam bater com o que o EasyPanel usa — confira com:
#   docker network ls | grep -i easypanel
#   docker inspect <container-do-traefik> --format '{{json .Config.Labels}}'
TRAEFIK_NETWORK=easypanel
TRAEFIK_ENTRYPOINT=https
TRAEFIK_CERTRESOLVER=letsencrypt
