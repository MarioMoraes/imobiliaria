# Frontend — copie para frontend/.env.local

# URL do backend (server-side; usada pelos Server Components/BFF).
BACKEND_URL=http://localhost:3001

# ── Autenticação (Clerk) ──────────────────────────────────────────
# Chaves do Clerk (Dashboard → API Keys). Sem elas, o Clerk roda em "keyless
# mode" em dev e o api.ts usa o fallback de tenant demo abaixo.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Administradores da PLATAFORMA (área /superadmin). Mesmo valor do backend —
# aqui só decide se a UI aparece; o gate que vale é o do backend. Vazio =
# /superadmin devolve 404 para todos.
PLATFORM_ADMIN_CLERK_IDS=

# Fallback de desenvolvimento (usado só quando NÃO há sessão Clerk).
# Tenant demo + papéis enviados ao backend via x-tenant-id/x-dev-roles. Só
# funciona com AUTH_DEV_MODE=true + NODE_ENV=development no backend.
DEMO_TENANT_ID=00000000-0000-0000-0000-000000000001
DEV_ROLES=ADMIN
