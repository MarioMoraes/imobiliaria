# Variáveis da stack no EasyPanel (docker-compose.easypanel.yml).
#
#   cp .env.easypanel.example .env.easypanel   # e preencha
#
# Diferenças em relação ao .env.production.example: não há ACME_EMAIL (quem
# emite o certificado é o Traefik do EasyPanel, com a conta ACME dele) e há o
# bloco TRAEFIK_* abaixo.
#
# NÃO commite o arquivo preenchido (o .gitignore já cobre .env.*).

# ── Domínio ───────────────────────────────────────────────────────
# Precisa de um registro A apontando para o IP da VPS ANTES de subir a stack.
# Cadastre o mesmo domínio no EasyPanel para ele saber que deve emitir o
# certificado.
APP_DOMAIN=imobiliaria.seudominio.com.br            # OBRIGATÓRIA

# ── Integração com o Traefik do EasyPanel ─────────────────────────
# Confirme os três na VPS antes do primeiro `up` — são a única parte que depende
# da instalação do EasyPanel, e um nome errado faz a stack subir saudável e
# mesmo assim responder 404 no domínio:
#
#   docker network ls | grep -i easypanel
#   cat /etc/easypanel/traefik/config/main.yaml   # entryPoints e certResolver
# Atenção ao entrypoint: o EasyPanel nomeia os seus `http`/`https`, e NÃO
# `web`/`websecure` como a convenção mais comum do Traefik. Um router que
# aponta para entrypoint inexistente simplesmente não atende — a stack sobe
# inteira e o domínio cai na página 404 do painel.
TRAEFIK_NETWORK=easypanel
TRAEFIK_ENTRYPOINT=https
TRAEFIK_CERTRESOLVER=letsencrypt

# ── Caminho da stack na VPS (bind mounts do init.sql) ─────────────
# Em Docker Swarm o `docker stack deploy` NÃO resolve caminho relativo de bind
# mount, e um caminho inexistente faz o Docker criar um diretório vazio em vez
# de falhar: o Postgres subiria sem schema nenhum. Use o caminho ABSOLUTO da
# pasta do repositório na VPS. Descubra o do EasyPanel com:
#   ls -d /etc/easypanel/projects/*/*/code
STACK_DIR=/etc/easypanel/projects/SEU_PROJETO/SEU_SERVICO/code

# ── Imagens ───────────────────────────────────────────────────────
# Referência COMPLETA (repositório:tag), como você publicou no registro.
# Atualizar a aplicação = trocar a tag aqui e rodar `pull` + `up -d`.
BACKEND_IMAGE=seuusuario/offices-backend:0.1.0       # OBRIGATÓRIA
FRONTEND_IMAGE=seuusuario/offices-frontend:0.1.0     # OBRIGATÓRIA

# ── Segredos do banco / fila ──────────────────────────────────────
# Gere cada um com um alfabeto SEGURO PARA URL:
#   LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32; echo
# Não use `openssl rand -base64`: ele produz `+` e `/`, e estas senhas são
# interpoladas CRUAS dentro de URLs (postgres://user:SENHA@host/db). Uma `/`
# encerra a seção de autoridade da URL e o backend autentica com credencial
# truncada — o erro que aparece é "password authentication failed", que não
# sugere em nada que a causa é o formato da senha.
POSTGRES_USER=imobiliaria
POSTGRES_PASSWORD=TROQUE_superusuario_do_postgres    # OBRIGATÓRIA
POSTGRES_DB=imobiliaria
# Senha do app_user (NÃO-superusuário) — é com ela que o backend conecta, e é o
# que faz o RLS ser aplicado. Definida no primeiro boot do volume.
APP_DB_PASSWORD=TROQUE_senha_do_app_user             # OBRIGATÓRIA

REDIS_PASSWORD=TROQUE_senha_do_redis                 # OBRIGATÓRIA
RABBITMQ_USER=imobiliaria
RABBITMQ_PASSWORD=TROQUE_senha_do_rabbit             # OBRIGATÓRIA

# ── Chave de cifragem em repouso ──────────────────────────────────
# Cifra os tokens de ZapSign/Asaas guardados por tenant. Gere UMA vez com
# `openssl rand -base64 32` e guarde: trocá-la depois torna ilegível tudo que
# já foi cifrado.
APP_ENCRYPTION_KEY=                                  # OBRIGATÓRIA

# ── Clerk (autenticação) ──────────────────────────────────────────
# ATENÇÃO: a pk_ é lida no BUILD da imagem do frontend, não aqui. Trocá-la exige
# reconstruir e republicar a imagem — mudar só esta linha não afeta o login.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxx        # OBRIGATÓRIA
CLERK_SECRET_KEY=sk_live_xxx                         # OBRIGATÓRIA
CLERK_JWT_KEY=
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/onboarding

# Administradores da PLATAFORMA (área /superadmin), por id de usuário do Clerk
# (user_...), separados por vírgula. Vazio = área trancada para todos —
# inclusive você. Pegue o seu id no painel do Clerk, em Users.
PLATFORM_ADMIN_CLERK_IDS=

# ── Armazenamento de mídia (fotos dos imóveis) ────────────────────
# S3-compatível; a recomendação é Cloudflare R2 (egress grátis). Sem isto o
# upload de fotos falha — o resto do sistema funciona.
S3_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=imobiliaria-media
S3_FORCE_PATH_STYLE=true

# ── E-mail transacional (convites de funcionário) ─────────────────
# Opcional. Sem a chave, o convite ainda é criado e o link fica copiável na UI.
RESEND_API_KEY=
MAIL_FROM=Offices AI <convites@seudominio.com.br>

LOG_LEVEL=info
