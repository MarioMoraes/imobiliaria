# Proxy reverso da stack de produção (docker-compose.prod.yml).
#
# O Caddy emite e renova o certificado sozinho (Let's Encrypt) assim que o
# domínio apontar para o IP da VPS — não há passo manual de TLS. Para isso as
# portas 80 e 443 precisam estar abertas no firewall: a 80 não é só redirect,
# é por onde vem o desafio ACME.

{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	encode zstd gzip

	# Webhooks dos provedores (Asaas, ZapSign) batem no BACKEND. Precisam ser
	# públicos: quem chama é o servidor do provedor, não o navegador do usuário.
	# A autenticação é o segredo por tenant no cabeçalho — ver os módulos
	# payment/signature. Esta rota tem de vir ANTES do handle geral.
	handle /webhooks/* {
		reverse_proxy backend:3001
	}

	# Sonda pública para conferir a stack de fora ("subiu?"). Devolve só status e
	# uptime; nenhum dado de tenant passa por aqui.
	handle /health* {
		reverse_proxy backend:3001
	}

	# Todo o resto é a aplicação Next.js. As chamadas ao backend saem de dentro
	# do frontend (Server Components/Actions) pela rede interna do compose, então
	# /v1/* NÃO é exposto — é a superfície de ataque a menos.
	handle {
		reverse_proxy frontend:3000
	}
}
