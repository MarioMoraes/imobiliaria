# ─────────────────────────────────────────────────────────────
# Variáveis de ambiente — copie para .env e ajuste conforme necessário.
# Backend e frontend também têm .env.example próprios em cada diretório.
# ─────────────────────────────────────────────────────────────

# Infra local (docker compose)
POSTGRES_USER=imobiliaria
POSTGRES_PASSWORD=imobiliaria
POSTGRES_DB=imobiliaria

# Tenant de demonstração criado pelo seed em infra/postgres/init.sql
DEMO_TENANT_ID=00000000-0000-0000-0000-000000000001
