# Backend — copie para backend/.env

NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Conecte-se como app_user (NÃO-superusuário) para que o RLS seja aplicado.
DATABASE_URL=postgres://app_user:app_user@localhost:5432/imobiliaria

REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# CORS — origem do frontend em dev
CORS_ORIGIN=http://localhost:3000

# ── Autenticação (MOD-AUTH-05, Clerk) ─────────────────────────────
# Chave secreta do Clerk (Dashboard → API Keys). Opcional em dev (ver AUTH_DEV_MODE).
# NUNCA commite a chave real — coloque em backend/.env (gitignored).
CLERK_SECRET_KEY=sk_test_xxx
# (Opcional) Chave pública do JWT em PEM p/ verificação networkless do token.
CLERK_JWT_KEY=

# Modo de desenvolvimento: sem Authorization, aceita os headers x-tenant-id +
# x-dev-roles (csv, ex.: "ADMIN") para simular a sessão. É um bypass completo da
# autenticação, então o default do código é FALSE e só vale com
# NODE_ENV=development — em qualquer outro ambiente é ignorado, e com
# NODE_ENV=production o boot falha.
AUTH_DEV_MODE=true

# Administradores da PLATAFORMA (área /superadmin e rotas /admin/*), por id de
# usuário do Clerk (`user_...`), separados por vírgula. Identidade separada do
# RBAC de tenant de propósito: um ADMIN de imobiliária não vira admin da
# plataforma. Vazio = área trancada. O mesmo valor vai no frontend.
PLATFORM_ADMIN_CLERK_IDS=

# ── Object storage (S3-compatível) ────────────────────────────────
# Mídia (fotos de imóveis) mora no bucket; o Postgres guarda só a chave.
# NÃO há MinIO no docker-compose: o bucket é externo (Cloudflare R2) também em
# desenvolvimento. Os defaults abaixo apontam para um MinIO que você teria de
# subir à mão — na prática, preencha com as credenciais do R2 de dev.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=imobiliaria-media
S3_FORCE_PATH_STYLE=true
# ── Gotenberg (HTML → PDF do contrato) ────────────────────────────
GOTENBERG_URL=http://localhost:3050

# ── Segredos em repouso ───────────────────────────────────────────
# Chave AES-256 (base64, 32 bytes) que cifra os tokens de terceiros no banco.
# Gere a sua: openssl rand -base64 32
# O default do código é um valor de DEV versionado; em produção o boot exige
# esta variável.
# APP_ENCRYPTION_KEY=

# ── Assinatura eletrônica (ZapSign) ───────────────────────────────
# O token da API NÃO fica aqui: é por tenant, cifrado no banco, configurado em
# Configurações → Assinatura Digital. Aqui vão só os endereços do provedor.
ZAPSIGN_API_URL=https://api.zapsign.com.br/api/v1
ZAPSIGN_SANDBOX_API_URL=https://sandbox.api.zapsign.com.br/api/v1

# ── Cobrança bancária (Asaas) ─────────────────────────────────────
# Mesma regra: a chave da API é por tenant, cifrada no banco, configurada em
# Configurações → Cobrança. Aqui vão só os endereços do provedor.
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_SANDBOX_API_URL=https://api-sandbox.asaas.com/v3

# URL pública deste backend — compõe os webhooks registrados na ZapSign e no
# Asaas. Em localhost o registro é pulado (use os botões "Sincronizar").
PUBLIC_BASE_URL=http://localhost:3001

# ── E-mail transacional (Resend) ──────────────────────────────────
# Aqui a credencial é da PLATAFORMA (não por tenant): quem envia é o produto,
# do seu próprio domínio verificado. Sem a chave o envio fica desligado — o
# convite ainda é criado no Clerk e o link segue recuperável na UI.
# O MAIL_FROM precisa usar um domínio VERIFICADO no Resend; caso contrário a
# API só entrega para o e-mail dono da conta.
# RESEND_API_KEY=
MAIL_FROM="Offices AI <convites@mail.offices-ia.cloud>"
RESEND_API_URL=https://api.resend.com

# URL pública do FRONTEND (≠ PUBLIC_BASE_URL acima, que é este backend).
# Compõe o redirectUrl do convite: para onde o convidado volta após aceitar.
APP_BASE_URL=http://localhost:3000

# ── Camada de IA (MOD-AI) ─────────────────────────────────────────
# Contas da PLATAFORMA (não por tenant): a imobiliária consome créditos de IA
# (tabela ai_credits), não traz a própria chave. Sem ANTHROPIC_API_KEY as rotas
# /v1/ai/* respondem 503 e o resto do produto segue funcionando.
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Modelo barato para classificar intenção/sentimento (tarefa de rótulo).
ANTHROPIC_FAST_MODEL=claude-haiku-4-5

# Embeddings do RAG. A Anthropic não tem API de embeddings; a Voyage é a
# parceira recomendada. ATENÇÃO: trocar VOYAGE_MODEL muda a dimensão do vetor e
# invalida o índice inteiro (rag_chunks.embedding é vector(1024)) — exige
# reindexação completa (POST /v1/ai/rag/reindex).
# VOYAGE_API_KEY=
VOYAGE_API_URL=https://api.voyageai.com/v1
VOYAGE_MODEL=voyage-3

# ── Provedor de IA ────────────────────────────────────────────────
# `anthropic` (padrão, alvo de produção) ou `gemini`. O Gemini existe para
# DESENVOLVIMENTO: o free tier permite exercitar o copiloto ponta a ponta sem
# conta paga. Os dois implementam as mesmas interfaces (modules/ai/providers).
AI_PROVIDER=anthropic

# Chave do Google AI Studio: https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# A série 2.5 já não é liberada para chaves novas (404 no longer available).
# O lite é o default porque o free tier limita gemini-3.6-flash a 5 req/minuto.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# Precisa suportar `outputDimensionality`: o índice espera 1024 dimensões, e é
# assim que o Gemini entrega vetores compatíveis com rag_chunks sem migração.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
