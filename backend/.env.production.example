# Backend — EXEMPLO de produção. Copie para o gerenciador de segredos do seu
# host (NÃO commite o arquivo real preenchido). Todos os valores abaixo são
# placeholders — substitua pelos reais.

NODE_ENV=production
PORT=3001
LOG_LEVEL=info

# ── Banco (Postgres gerenciado) ───────────────────────────────────
# Conecte como usuário NÃO-superusuário para que o RLS seja aplicado.
# Use SSL em produção (?sslmode=require, conforme o provedor).
DATABASE_URL=postgres://app_user:SENHA_FORTE@db.seu-host.com:5432/imobiliaria?sslmode=require

REDIS_URL=redis://:SENHA@redis.seu-host.com:6379
RABBITMQ_URL=amqps://usuario:SENHA@rabbit.seu-host.com:5671

# CORS — origem(ns) do frontend em produção (HTTPS).
CORS_ORIGIN=https://app.suaimobiliaria.com

# ── Autenticação (Clerk) ──────────────────────────────────────────
# Chaves de PRODUÇÃO do Clerk (sk_live_...). Mantenha no gerenciador de segredos.
CLERK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxx
# (Opcional) Chave pública do JWT em PEM p/ verificação networkless do token.
CLERK_JWT_KEY=

# OBRIGATÓRIO em produção: o boot FALHA se isto ficar 'true' (bypass de auth).
AUTH_DEV_MODE=false

# ── Object storage — Cloudflare R2 (S3-compatível, egress grátis) ──
# Console R2 → "Manage R2 API Tokens" gera Access Key ID + Secret Access Key.
# Endpoint = https://<ACCOUNT_ID>.r2.cloudflarestorage.com  (ID da conta no painel R2).
# Região sempre "auto" no R2. Mantém path-style (compatível). O bucket é criado
# pelo backend no 1º upload (ensureBucket); ou crie-o manualmente no console.
S3_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
S3_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
S3_BUCKET=imobiliaria-media
S3_FORCE_PATH_STYLE=true

# Alternativa AWS S3 (egress pago): endpoint padrão do SDK por região —
# deixe S3_ENDPOINT vazio e ajuste S3_REGION (ex.: sa-east-1, São Paulo).
#   S3_ENDPOINT=
#   S3_REGION=sa-east-1
#   S3_ACCESS_KEY=AKIA...
#   S3_SECRET_KEY=...
#   S3_BUCKET=imobiliaria-media
#   S3_FORCE_PATH_STYLE=false
