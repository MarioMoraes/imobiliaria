# Configuração do PACOTE de demonstração (scripts/gerar-pacote-demo.sh).
#
#   cp .env.demo.example .env.demo   # e preencha as chaves do Clerk
#
# Estes valores são embutidos no pacote que você entrega ao cliente — ele não
# edita nada, só carrega as imagens e sobe. O arquivo real é ignorado pelo git.

# ── Clerk ─────────────────────────────────────────────────────────
# Use uma instância de TESTE (pk_test_/sk_test_): ela aceita qualquer origem,
# inclusive http://localhost:3000, sem cadastrar domínio.
#
# ATENÇÃO: a sk_ vai dentro do pacote entregue. Quem tem essa chave administra o
# diretório de usuários daquela instância do Clerk. Crie uma instância separada
# só para demonstrações em vez de reaproveitar a do seu desenvolvimento — assim
# uma chave que vaze não alcança nada seu.
#
# Configure na instância (senão o login entra mas todo request devolve 401):
#  • Sessions → Customize session token: {"tenant_id":"{{org.public_metadata.tenant_id}}"}
#  • Organizations habilitado
#  • Senha habilitada como método de login
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Id do seu usuário do Clerk (user_...) se quiser acessar /superadmin na demo.
# Vazio = área trancada.
PLATFORM_ADMIN_CLERK_IDS=

# ── Armazenamento de fotos (opcional) ─────────────────────────────
# Sem isto, tudo funciona menos o upload de foto de imóvel. Para uma demo
# offline, deixe vazio; os imóveis de exemplo não dependem de foto.
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=imobiliaria-media
S3_FORCE_PATH_STYLE=true

# ── Nomes das imagens geradas ─────────────────────────────────────
BACKEND_IMAGE=offices-ai/backend:demo
FRONTEND_IMAGE=offices-ai/frontend:demo

# Chave de cifragem em repouso. Deixe VAZIA: o script gera uma por pacote.
APP_ENCRYPTION_KEY=
